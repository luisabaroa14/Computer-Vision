# Computer Vision Zone Monitoring Configuration

# Input Source: 0 (webcam), path to video file, or RTSP stream
VIDEO_SOURCE=0
# VIDEO_SOURCE=rtsp://<username>:<password>@<camera-ip>:554/live

# Target Resolution (Width x Height)
FRAME_WIDTH=854
FRAME_HEIGHT=480

# Motion Detection Parameters
MOTION_MIN_AREA=3000

# Recording Options
RECORD_OUTPUT=false
OUTPUT_VIDEO_PATH=output_videos/monitoring_output.avi
